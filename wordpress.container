[Unit]
Description=Wordpress

[Container]
# 1. Use the official base image
Image=ghcr.io/cody-chapman/wordpress:latest
ContainerName=wordpress
# 2. Tell systemd it is running inside an OCI container
Environment=container=podman SYSTEMD_LOG_TARGET=console
Environment=SQLUSER=root
Environment=SQLHOST=127.0.0.1
SecurityLabelDisable=true

# 3. Boot systemd as the primary process (PID 1)
Exec=/usr/lib/systemd/systemd
AddCapability=sys_admin


# CRITICAL: Grant permission to mount filesystems
AddCapability=CAP_SYS_ADMIN
AddCapability=DAC_READ_SEARCH
PublishPort=80:80

Volume=/data/picupload:/home/vnaftp:Z
Volume=/data/picupload:/home/vnaftp:Z
Volume=/data/picupload:/home/vnaftp:Z

Tmpfs=/run
Tmpfs=/tmp

#4. Access to secrets
Secret=sqlpassword

# 5. Enable auto-updates via 'podman auto-update'
AutoUpdate=registry

# 6. Configure a systemd-managed restart policy
# Note: Quadlet uses systemd's 'Restart=' key in the [Service] section instead of podman's '--restart' flag.
[Service]
Restart=always

# 7. Health Check (Example: Checks if systemd inside the container is responsive)
[Container]
HealthCmd=pidof systemd
HealthStartPeriod=30s
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3

[Install]
WantedBy=default.target
